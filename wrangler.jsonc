{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abank-village-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abank-bookings",
      "database_id": "bdbc1fd1-90f3-4ef7-8e3a-d8076ea5e81d",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/30 * * * *"] },
  // Production settings. Payments stay switched off until real Paystack/PayPal keys are added as secrets.
  "vars": {
    "PAYMENT_MODE": "live",
    "PAYPAL_ENV": "live",
    "SITE_URL": "https://abankvillage.com",
    "HOTEL_EMAIL": "stayabankvillage@gmail.com",
    "EMAIL_FROM": "",
    // Real Turnstile site key goes here before launch (secret goes in TURNSTILE_SECRET_KEY).
    "TURNSTILE_SITE_KEY": ""
  },
  // Preview builds (non-main branches): separate database, simulated payments, test bot-check key.
  "previews": {
    "vars": {
      "PAYMENT_MODE": "demo",
      "PAYPAL_ENV": "sandbox",
      "SITE_URL": "",
      "HOTEL_EMAIL": "",
      "EMAIL_FROM": "",
      "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "abank-bookings-preview",
        "database_id": "eab96363-4f20-445d-82fa-7931db7cbf8a"
      }
    ],
    "send_email": [{ "name": "EMAIL" }]
  },
  "observability": { "enabled": true }
}
